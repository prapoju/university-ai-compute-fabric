# Module 12 - AI Operations Copilot: runtime configuration reference.
# The service reads real environment variables only - it does NOT load a .env file.
# Set them in the shell (export M12_LOG_LEVEL=DEBUG), under `environment:` in
# docker-compose.yml, or with `docker run -e`. Every variable is optional; the values below
# are the defaults the tests use. Relative paths resolve against the project root.

# Directory holding the seeded estate (users, catalog, nodes, ...). Read-only.
M12_FIXTURES_DIR=fixtures

# SQLite file for the Module-12-owned stores. ":memory:" keeps everything ephemeral.
M12_DB_PATH=:memory:

# Directory with the numbered *.sql migrations applied at startup.
M12_MIGRATIONS_DIR=migrations

# Simulated wall clock (ISO-8601 UTC). The deterministic core never reads real time (DP-5).
M12_CLOCK_START=2026-10-16T15:00:00.000Z

# DEBUG | INFO | WARNING | ERROR
M12_LOG_LEVEL=INFO
